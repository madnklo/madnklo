#***********************************************************************
#                    MadNkLO (Torino subtraction)                      *
#                                                                      *
#                           run_card.dat                               *
#                                                                      *
#  This file sets the parameters of the run. It is read by             *
#  bin/run_all.py, which compiles it into Source/run_card.inc when it  *
#  has been modified (no need to recompile by hand).                   *
#                                                                      *
#  Some notation/conventions:                                          *
#                                                                      *
#   Lines starting with a hash (#) are info or comments                *
#                                                                      *
#   mind the format:   value    = variable     ! comment               *
#                                                                      *
#   Some of the values of variables can be list. These can either be   *
#   comma or space separated.                                          *
#***********************************************************************
#
#***********************************************************************
# Integration: VEGAS calls and iterations of each contribution, first  *
# to set up the grid (_grid), then for the cross section.              *
#***********************************************************************
# Born
 %(npoints_b_grid)s = npoints_B_grid ! calls to setup the B grid
 %(niters_b_grid)s  = niters_B_grid  ! iterations to setup the B grid
 %(npoints_b)s      = npoints_B      ! calls for the B cross section
 %(niters_b)s       = niters_B       ! iterations for the B cross section
# Virtual
 %(npoints_v_grid)s = npoints_V_grid ! calls to setup the V grid
 %(niters_v_grid)s  = niters_V_grid  ! iterations to setup the V grid
 %(npoints_v)s      = npoints_V      ! calls for the V cross section
 %(niters_v)s       = niters_V       ! iterations for the V cross section
# Real: point budgets are shared among the generated sectors
 %(npoints_r_grid)s = npoints_R_grid ! total calls to setup the R grids
 %(niters_r_grid)s  = niters_R_grid  ! iterations to setup each R grid
 %(npoints_r)s      = npoints_R      ! total calls for the R cross section
 %(niters_r)s       = niters_R       ! iterations for each R sector
# Double virtual
 %(npoints_vv_grid)s = npoints_VV_grid ! calls to setup the VV grid
 %(niters_vv_grid)s  = niters_VV_grid  ! iterations to setup the VV grid
 %(npoints_vv)s      = npoints_VV      ! calls for the VV cross section
 %(niters_vv)s       = niters_VV       ! iterations for the VV cross section
# Real virtual: point budgets are shared among the generated sectors
 %(npoints_rv_grid)s = npoints_RV_grid ! total calls to setup the RV grids
 %(niters_rv_grid)s  = niters_RV_grid  ! iterations to setup each RV grid
 %(npoints_rv)s      = npoints_RV      ! total calls for the RV cross section
 %(niters_rv)s       = niters_RV       ! iterations for each RV sector
# Double real: point budgets are shared among the generated sectors
 %(npoints_rr_grid)s = npoints_RR_grid ! total calls to setup the RR grids
 %(niters_rr_grid)s  = niters_RR_grid  ! iterations to setup each RR grid
 %(npoints_rr)s      = npoints_RR      ! total calls for the RR cross section
 %(niters_rr)s       = niters_RR       ! iterations for each RR sector
#***********************************************************************
# Random number seed. All the executables of a run use the same seed;  *
# 0 and 1 give the same random numbers. Use different seeds for        *
# statistically independent runs.                                      *
#***********************************************************************
 %(iseed)s    = iseed       ! random number seed
#***********************************************************************
# Fixed-order analysis: the Fortran file in Common_Files/ that fills   *
# the histograms (routines analysis_begin, analysis_fill and           *
# analysis_end). bin/run_all.py compiles it in the executables.        *
#***********************************************************************
 %(analysis)s = analysis ! analysis file in Common_Files/
#***********************************************************************
# Histogram bin smearing. Each histogram fill within hwu_smear bin     *
# widths of an inner bin edge shares part of its weight with the       *
# neighbouring bin (linear kernel, half-width hwu_smear x bin width),  *
# so that real-emission events and counterevents falling on opposite   *
# sides of a bin edge still cancel (no mis-binning spikes). Totals     *
# are unchanged; distributions are smeared over hwu_smear bin widths.  *
# 0 = no smearing; maximum 0.5.                                        *
#***********************************************************************
 %(hwu_smear)s = hwu_smear ! bin smearing, in units of the bin width
#***********************************************************************
# Collider type and energy                                             *
# Only lepton beams (lpp = 0) are supported for now: with hadron beams *
# (lpp = 1, -1, 2, -2) the PDF weights are not applied yet.            *
#***********************************************************************
 %(lpp1)s   = lpp1    ! beam 1 type (0 = no PDF)
 %(lpp2)s   = lpp2    ! beam 2 type (0 = no PDF)
 %(ebeam1)s   = ebeam1  ! beam 1 energy in GeV
 %(ebeam2)s   = ebeam2  ! beam 2 energy in GeV
#***********************************************************************
# PDF choice: used only with hadron beams (lpp != 0, not supported     *
# yet), where it would also fix alpha_s(MZ) and its running.           *
# With lpp = 0, alpha_s(MZ) is the aS entry of the param_card.         *
#***********************************************************************
 %(pdlabel)s = pdlabel ! PDF set
 %(lhaid)s  = lhaid   ! If pdlabel=lhapdf, this is the lhapdf number.
#***********************************************************************
# Renormalisation and factorisation scales                             *
# - fixed_ren_scale = True: muR = muR_over_ref * muR_ref_fixed         *
# - fixed_ren_scale = False: muR = muR_over_ref * (the dynamical scale *
#   chosen with dynamical_scale_choice), computed for each phase-space *
#   point (and for each counterterm from its mapped momenta):          *
#     3 = H_T/2, half the sum of the transverse masses of the          *
#         final-state QCD partons                                      *
#     4 = partonic centre-of-mass energy sqrt(s_hat)                   *
#   Any other value stops the run. One value only.                     *
# - The factorisation scale (muF) is used only with hadron beams (not  *
#   supported yet).                                                    *
#***********************************************************************
 %(fixed_ren_scale)s    = fixed_ren_scale  ! True: fixed muR, False: dynamical muR
 %(fixed_fac_scale)s    = fixed_fac_scale  ! True: fixed muF (hadron beams only)
 %(mur_ref_fixed)s   = muR_ref_fixed    ! fixed reference muR in GeV
 %(muf_ref_fixed)s   = muF_ref_fixed    ! fixed reference muF in GeV (hadron beams only)
 %(dynamical_scale_choice)s = dynamical_scale_choice ! 3 or 4 (see above), used if fixed_ren_scale = False
 %(mur_over_ref)s  = muR_over_ref  ! muR = muR_over_ref * reference muR
 %(muf_over_ref)s  = muF_over_ref  ! muF = muF_over_ref * reference muF (hadron beams only)
#***********************************************************************
# Scale variations by reweighting (no extra matrix-element calls).     *
# With reweight_scale = True, the cross section and the histograms are *
# also computed at muR = k * muR, for each factor k of rw_rscale (at   *
# most 9 values; 1.0 is always included): results_*.log, results.txt  *
# and the HwU files (same weight layout as MG5_aMC: one weight per     *
# (muF, muR) pair of rw_fscale x rw_rscale; without PDFs the muF       *
# factors do not change the result).                                   *
#***********************************************************************
 %(rw_rscale)s = rw_rscale ! muR factors k
 %(rw_fscale)s = rw_fscale ! muF factors (hadron beams only; HwU layout)
 %(reweight_scale)s = reweight_scale ! True: compute the muR variations
 %(reweight_pdf)s = reweight_PDF  ! PDF uncertainties by reweighting: not available yet
#***********************************************************************
# Reweighting information in LHE files: not available yet (no events) *
#***********************************************************************
 %(store_rwgt_info)s = store_rwgt_info ! not used yet
#***********************************************************************
# BW cutoff: only for processes generated with decay-chain syntax      *
# (forced s-channel resonances), whose invariant mass is restricted to *
# M +- bwcutoff*Gamma in the phase-space generation. Not used for the  *
# other processes.                                                     *
#***********************************************************************
 %(bwcutoff)s  = bwcutoff
#***********************************************************************
# Cuts on the jets, applied in Common_Files/cuts.f (more specific cuts *
# can be added there). Jet clustering is performed by FastJet. The     *
# quark flavours clustered into jets are the massless quarks of the    *
# model (set automatically, not a run_card parameter).                 *
#***********************************************************************
  %(jetalgo)s  = jetalgo   ! FastJet jet algorithm (1=kT, 0=C/A, -1=anti-kT)
  %(jetradius)s  = jetradius ! The radius parameter for the jet algorithm
 %(ptj)s  = ptj       ! Min jet transverse momentum
 %(etaj)s  = etaj      ! Max jet abs(pseudo-rap) (a value .lt.0 means no cut)
#***********************************************************************
# Cuts on the charged leptons (e+, e-, mu+, mu-, tau+ and tau-) in the *
# final state, applied in Common_Files/cuts.f                          *
#***********************************************************************
  %(ptl)s  = ptl     ! Min lepton transverse momentum
 %(etal)s  = etal    ! Max lepton abs(pseudo-rap) (a value .lt.0 means no cut)
  %(drll)s  = drll    ! Min distance between opposite sign lepton pairs
  %(drll_sf)s  = drll_sf ! Min distance between opp. sign same-flavor lepton pairs
  %(mll)s  = mll     ! Min inv. mass of all opposite sign lepton pairs
 %(mll_sf)s  = mll_sf  ! Min inv. mass of all opp. sign same-flavor lepton pairs
#***********************************************************************
# Photon-isolation cuts, according to hep-ph/9801442, applied in       *
# Common_Files/cuts.f. When ptgmin=0, all the other parameters are     *
# ignored.                                                             *
#***********************************************************************
 %(ptgmin)s  = ptgmin    ! Min photon transverse momentum
 %(etagamma)s  = etagamma  ! Max photon abs(pseudo-rap)
  %(r0gamma)s  = R0gamma   ! Radius of isolation code
  %(xn)s  = xn        ! n parameter of eq.(3.4) in hep-ph/9801442
  %(epsgamma)s  = epsgamma  ! epsilon_gamma parameter of eq.(3.4) in hep-ph/9801442
 %(isoem)s  = isoEM  ! isolate photons from EM energy (photons and leptons)
#***********************************************************************
# aMCfast + APPLgrid interface (PDF fits): not available yet           *
#***********************************************************************
 %(iappl)s = iappl ! not used yet (keep 0)
#***********************************************************************

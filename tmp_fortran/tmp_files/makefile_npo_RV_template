.PHONY: clean libs
clean:
	rm -rf $(OBJ)/*.o ../../lib/libdhelas.a ../../lib/RV_libdhelas.a
	cd ../../../Source; make clean; cd -

libs:
	mkdir -p $(OBJ)
	cd ../../Source/DHELAS; make; cd -
